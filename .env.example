# acp-http-gateway — Docker 环境变量示例
#
# 启动时用 -e 传入即可（也可直接写进 docker run 命令）：
#
#   docker run -d -p 8766:8766 \
#     -e ACP_BEARER_TOKEN=你的token \
#     -v ~/.pi/agent:/root/.pi/agent \
#     acp-http-gateway:latest

# REQUIRED: clients must send this as `Authorization: Bearer <token>`.
ACP_BEARER_TOKEN=change-me

# Optional
# ACP_LOG_LEVEL=INFO
# ACP_OPENAI_POOL_MAX=20
# ACP_OPENAI_POOL_IDLE=600
